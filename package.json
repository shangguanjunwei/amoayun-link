{
  "name": "@amoayun/dsh-amoayun-link-plugin",
  "version": "2.3.4",
  "private": false,
  "description": "Standalone Amoayun Link bridge and control panel plugin for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "scripts/register.mjs",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "amoayun",
    "link",
    "messaging",
    "agent"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/service.js && node --check lib/ui.js && node --check lib/upstream/client.js && node --check lib/upstream/runtime.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "amoayun-link-register": "scripts/register.mjs"
  }
}
